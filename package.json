{
  "name": "copilot-notifications-canvas",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:workflows": "actionlint",
    "test": "node --test test/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/*.mjs' --test-coverage-include='.github/extensions/github-notifications/extension.mjs' --test-coverage-include='scripts/*.mjs' --test-coverage-exclude='scripts/coverage-reporter.mjs' --test-coverage-exclude='scripts/build-release.mjs' --test-coverage-lines=95 --test-coverage-branches=95 --test-coverage-functions=95 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./scripts/coverage-reporter.mjs --test-reporter-destination=stdout test/*.test.mjs",
    "test:browser": "playwright test",
    "build": "node scripts/build-release.mjs",
    "test:package": "node --test test/package.integration.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "tar": "7.5.22"
  }
}
